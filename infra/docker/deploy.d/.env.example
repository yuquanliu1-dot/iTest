# Release target config template: cp .env.example prod.env, then fill in actual values
# deploy.d/<env>.env contains server passwords; everything in this directory except .env.example and README.md is gitignored.

# SSH connection
DEPLOY_SSH_USER=wangb
DEPLOY_SSH_HOST=192.168.30.228
DEPLOY_SSH_PORT=22
# Empty = use local ssh key; non-empty = password login via sshpass (local machine needs sshpass installed)
DEPLOY_SSH_PASSWORD=

# Application root directory on the server (tarball is always uploaded to <DEPLOY_REMOTE_DIR>.tar.gz)
DEPLOY_REMOTE_DIR=/home/wangb/itest

# Number of database backups to retain on the server (oldest deleted automatically beyond this)
DEPLOY_BACKUP_KEEP=10

# Horizontal scaling of execution: API replica count (default 1). Multiple replicas need shared redis + an execution queue; nginx round-robins internally.
DEPLOY_API_REPLICAS=1
# Per-container chromium concurrency gate (default 3): peak concurrent chromium ≈ replicas × this value. Reduce if OOM is a concern.
DEPLOY_EXEC_CONCURRENCY=3
