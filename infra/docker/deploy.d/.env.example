# 发布目标配置模板：cp .env.example prod.env 后按实际填写
# deploy.d/<env>.env 含服务器密码，整目录除 .env.example 与 README.md 外都进 gitignore。

# SSH 连接
DEPLOY_SSH_USER=wangb
DEPLOY_SSH_HOST=192.168.30.228
DEPLOY_SSH_PORT=22
# 留空 = 走本机 ssh key；非空 = 用 sshpass 密码登录（本机需装 sshpass）
DEPLOY_SSH_PASSWORD=

# 服务器上应用根目录（tarball 固定传到 <DEPLOY_REMOTE_DIR>.tar.gz）
DEPLOY_REMOTE_DIR=/home/wangb/itest

# 服务器上数据库备份保留份数（超过自动删最旧的）
DEPLOY_BACKUP_KEEP=10

# 执行水平扩展:API 副本数(默认 1)。多副本需共享 redis + 有执行队列;nginx 内部轮询分发。
DEPLOY_API_REPLICAS=1
# 每容器 chromium 并发闸门(默认 3):峰值并发 chromium ≈ 副本数 × 该值。OOM 隐患时调小。
DEPLOY_EXEC_CONCURRENCY=3
