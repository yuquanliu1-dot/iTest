FROM node:22-bookworm-slim AS api-build
WORKDIR /repo
# Copy workspace top level
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json turbo.json ./
COPY apps/api/package.json apps/api/tsconfig.json apps/api/drizzle.config.ts ./apps/api/
COPY apps/recorder/package.json apps/recorder/tsconfig.json apps/recorder/tsconfig.build.json ./apps/recorder/
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/ui/package.json packages/ui/tsconfig.json ./packages/ui/

ENV CI=true
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate \
 && pnpm install --frozen-lockfile --filter @itest/api... --filter @itest/shared --filter @itest/recorder --filter @itest/ui

# Copy source (only what the api runtime needs)
COPY apps/api/src ./apps/api/src
COPY apps/api/drizzle ./apps/api/drizzle
COPY apps/api/scripts ./apps/api/scripts
COPY packages/shared/src ./packages/shared/src
COPY packages/ui/src ./packages/ui/src
# recorder package: copy manifest/popup/content/background and other runtime files + prebuilt modules.
# node_modules is left to the pnpm install --prod stage; modules are generated by tsc/esbuild after pnpm --filter @itest/recorder build.
COPY apps/recorder/manifest.json ./apps/recorder/manifest.json
COPY apps/recorder/popup ./apps/recorder/popup
COPY apps/recorder/content ./apps/recorder/content
COPY apps/recorder/background.js ./apps/recorder/background.js
COPY apps/recorder/modules ./apps/recorder/modules
# _locales: the manifest declares default_locale:"zh_CN"; Chrome validates the _locales subtree when loading
# the extension and reports "Default locale was specified, but _locales subtree is missing", refusing to install
# (observed on prod228, 2026-10-20: image missed this directory → users could not install the extension). Must be copied together with the manifest.
COPY apps/recorder/_locales ./apps/recorder/_locales

RUN pnpm --filter @itest/shared build || true \
 && pnpm --filter @itest/recorder build \
 && pnpm --filter @itest/api build

# ----- runtime -----
FROM node:22-bookworm-slim AS api
# build context defaults to the repo root (infra/docker/deploy.sh:25 uses . as context).
# WORKDIR /repo keeps the infra/docker/certs path consistent with the api-build stage.
WORKDIR /repo
ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=54321 \
    PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright \
    PI_DATA_DIR=/repo/apps/api/.data
# Runtime system dependencies: repo checkout needs git + ca-certificates; repo_grep needs ripgrep;
# chromium needs a set of graphics/font libraries (playwright-core ships a CLI to install browsers, --with-deps installs the system .so files).
# python3: python3 runtime for the AI assistant's run_skill_script (node/bash/sh are also bundled by default).
# python3-yaml: the official skill-creator's scripts/quick_validate.py needs PyYAML (2026-10-19) —
#   installed via apt system package rather than pip: bookworm ships it, no --break-system-packages/venv needed.
# python3-docx: used by the word-test-report skill to generate .docx (2026-10-28); without it the skill
#   automatically falls back to hand-writing OOXML with the stdlib zipfile — installing it only improves report styling, not a hard dependency.
# bookworm-slim ships no system binaries at all, so apt-get is mandatory. See infra/docker/certs/README.md.
# Fonts: exploratory-testing evidence screenshots are rendered by in-container chromium; without CJK fonts all Chinese text renders as boxes —
#   the AI reports "missing fonts" as defects (prod228 record, 2026-11-10: one exploration reported 3 false defects),
#   and evidence screenshots become unreadable. fonts-wqy-zenhei is the CJK font from Playwright's official Debian dependency list (small).
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates ripgrep unzip python3 python3-yaml python3-docx \
      libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 \
      libxkbcommon0 libxcomposite1 libxdamage1 libxext6 libxfixes3 \
      libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 libatspi2.0-0 \
      fontconfig fonts-liberation fonts-wqy-zenhei fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# 2026-10-09: the internal GitLab's certificate is signed only for its IP, with no SAN match, so git rejects it by default;
# TLS verification is globally disabled in the image. Trade-off: git inside the container never verifies certificates — ops-controlled and documented.
RUN git config --global http.sslVerify false

# Self-signed CAs (optional; update-ca-certificates runs if infra/docker/certs/*.crt exist).
# COPY fails the whole build when the source matches no glob, so use RUN + shopt glob probing + cp; works with an empty directory too.
# The cert-copy layer is kept separate from update-ca-certificates so a buildkit-cached layer can never cause missing certs.
COPY infra/docker/certs/ /tmp/itest-certs/
RUN cp /tmp/itest-certs/*.crt /usr/local/share/ca-certificates/ 2>/dev/null || echo "no .crt files in infra/docker/certs/"
RUN rm -rf /tmp/itest-certs
RUN if ls /usr/local/share/ca-certificates/*.crt >/dev/null 2>&1; then \
      update-ca-certificates && echo "custom CAs loaded"; \
    else \
      echo "no custom CA certs; using system CA only"; \
    fi

# Copy built source + dependencies
COPY --from=api-build /repo /repo
WORKDIR /repo/apps/api
# COREPACK_NPM_REGISTRY: prod228 only resolves IPv6 addresses for registry.npmjs.org and the IPv6 egress is dead,
#   so corepack's pnpm fetch hangs (observed: curl times out with 000 by default, curl -4 returns 200 instantly).
#   npmmirror is the only reliable route — NODE_OPTIONS=--dns-result-order=ipv4first was tried first and did not work:
#   corepack fires its DNS resolution early in Node startup, before that ENV takes effect.
#   With this variable set, corepack prepare pnpm@9.12.0 --activate completes in seconds (observed).
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate \
 && pnpm install --prod --frozen-lockfile --filter @itest/api... --filter @itest/shared --filter @itest/recorder --filter @itest/ui
# chromium offline-first: direct connections to the playwright CDN from mainland China are extremely slow (11min+ per browser observed);
# zips are pre-downloaded onto the server under infra/docker/ (c1243-*.zip, ~316MB total; not in git nor in the release tarball,
# pre-staged by ops via scp; tar unpacking never deletes existing files, so the zips stay available on the server).
# After COPYing the whole directory, branch on existence: when the zips are missing, fall back to network download
# (slow but workable; failure only warns — deploy.sh smoke catches it early).
# Version corresponds to chromium build 1243 in playwright-core ~1.63's browsers.json; switch the zips in lockstep when upgrading playwright.
COPY infra/docker/ /tmp/itest-pw/
RUN mkdir -p /root/.cache/ms-playwright \
 && if [ -f /tmp/itest-pw/c1243-chrome.zip ] && [ -f /tmp/itest-pw/c1243-shell.zip ]; then \
      unzip -q /tmp/itest-pw/c1243-chrome.zip -d /root/.cache/ms-playwright/chromium-1243 \
   && unzip -q /tmp/itest-pw/c1243-shell.zip -d /root/.cache/ms-playwright/chromium_headless_shell-1243 \
   && touch /root/.cache/ms-playwright/chromium-1243/INSTALLATION_COMPLETE \
            /root/.cache/ms-playwright/chromium_headless_shell-1243/INSTALLATION_COMPLETE \
   && echo "chromium installed from offline zips"; \
    else \
      pnpm exec playwright-core install chromium chromium-headless-shell \
   || echo "WARN: playwright browser install failed; chrome may be missing at runtime"; \
    fi \
 && rm -rf /tmp/itest-pw
EXPOSE 54321
# Schema sync uses drizzle-kit push (schema.ts is the source of truth; the migrations history is incomplete and not replayable);
# migrate.js takes the PG advisory lock before pushing, serializing concurrent multi-container startups to prevent conflicts.
CMD ["sh", "-c", "node dist/db/migrate.js && node dist/index.js"]