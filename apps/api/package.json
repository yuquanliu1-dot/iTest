{
  "name": "@itest/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "TESTCONTAINERS_RYUK_DISABLED=true vitest run",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:sync:locked": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@earendil-works/pi-ai": "~0.99.2",
    "@earendil-works/pi-coding-agent": "~0.99.2",
    "@google/generative-ai": "^0.21.0",
    "@itest/recorder": "workspace:*",
    "@itest/shared": "workspace:*",
    "agent-device": "^0.21.22",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.36.0",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.5",
    "openai": "^4.73.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright-core": "~1.63.0",
    "proper-lockfile": "^4.1.2",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.2.0",
    "@testcontainers/postgresql": "^10.13.2",
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/ssh2": "^1.15.6",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.14.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
