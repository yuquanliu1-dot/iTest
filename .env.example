DATABASE_URL=postgres://itest:itest@localhost:5432/itest
REDIS_URL=redis://localhost:6379
API_PORT=54321
WEB_PORT=5173
# API 监听地址：录制扩展机器与服务端不同机时改 0.0.0.0
API_HOST=127.0.0.1
# Web dev server 监听地址（vite.config.ts 读取）：跨机器访问时改 0.0.0.0
WEB_HOST=127.0.0.1
# 录制扩展回连的 WS 完整地址（指向 API 端口，不能指向 web 端口），path 为空时自动补 /recorder。
# 跨机器示例：ws://192.168.1.10:54321/recorder。
# 注意：ws:// 明文且 wsToken 经 query 传输，勿暴露公网；生产用 wss + 反向代理。
RECORDER_PUBLIC_WS_URL=ws://127.0.0.1:54321/recorder
RECORDER_TOKEN_SECRET=dev-secret-change-me
# 登录会话 JWT 密钥（生产必须更换；种子账号 admin/admin123，首登强制改密）
AUTH_JWT_SECRET=dev-auth-secret-change-me
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=