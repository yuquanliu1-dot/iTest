DATABASE_URL=postgres://itest:itest@localhost:5432/itest
REDIS_URL=redis://localhost:6379
API_PORT=54321
WEB_PORT=5173
# API listen address: set to 0.0.0.0 when the recorder extension runs on a different host
API_HOST=127.0.0.1
# Web dev server listen address (read by vite.config.ts): set to 0.0.0.0 for cross-machine access
WEB_HOST=127.0.0.1
# Full WS address the recorder extension connects back to (points at the API port, never the web port);
# the /recorder path is appended automatically when empty.
# Cross-machine example: ws://192.168.1.10:54321/recorder.
# Note: ws:// is plaintext and wsToken travels via query string; do not expose to the public internet.
# Use wss + a reverse proxy in production.
RECORDER_PUBLIC_WS_URL=ws://127.0.0.1:54321/recorder
RECORDER_TOKEN_SECRET=dev-secret-change-me
# Login session JWT secret (must be replaced in production; seed account admin/admin123, forced password change on first login)
AUTH_JWT_SECRET=dev-auth-secret-change-me
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=